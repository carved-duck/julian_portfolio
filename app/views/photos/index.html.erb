<div class="container mt-4" data-controller="photo-protection">
  <!-- Breadcrumb Navigation -->
  <nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb">
      <li class="breadcrumb-item">
        <%= link_to "Home", root_path, class: "text-decoration-none" %>
      </li>
      <li class="breadcrumb-item active" aria-current="page">Photos</li>
    </ol>
  </nav>
  <h1 class="mb-4 page-title">Photo Gallery</h1>
  <% if @categories.any? %>
    <!-- Unified category filter (one pill style, all breakpoints) -->
    <nav class="photo-filter" aria-label="Filter photos by category">
      <% @categories.each do |category| %>
        <%= link_to category.titleize, photos_path(category: category), class: "category-pill #{'active' if @selected_category == category}" %>
      <% end %>
    </nav>
  <% end %>
  <% roll = @photos.select { |photo| photo.image.attached? } %>
  <% if roll.any? %>
    <%# Every photo opens the full-size viewer on black (photos/_photo_modal); without JS the link
        goes to the photo's own page. The strip and the grid are two views of the same roll, so the
        viewer's arrows step through it once, in roll order. %>
    <section class="contact-sheet" aria-label="Contact sheet: <%= @selected_category %>">
      <p class="contact-sheet-edge" aria-hidden="true">
        <span><%= @selected_category.upcase %></span><span><%= roll.size %> frames</span>
      </p>
      <ol class="contact-sheet-frames">
        <% roll.each_with_index do |photo, index| %>
          <li class="contact-frame">
            <%= link_to photo_path(photo), class: "contact-frame-link", aria: { label: "Open frame #{index + 1}" },
                data: photo_viewer_data(photo) do %>
              <%= cl_image_tag photo.image.key,
                  width: 240, height: 160, crop: :fill, quality: :auto, fetch_format: :auto,
                  alt: "", loading: "lazy", draggable: false, oncontextmenu: "return false;" %>
            <% end %>
            <span class="contact-frame-number" aria-hidden="true"><%= index + 1 %></span>
          </li>
        <% end %>
      </ol>
    </section>

    <div class="photo-grid">
      <% roll.each_with_index do |photo, index| %>
        <%= link_to photo_path(photo), class: "photo-grid-item", id: "photo-#{photo.id}", data: photo_viewer_data(photo) do %>
          <%= cl_image_tag photo.image.key,
              width: 400, height: 400, crop: :fill, quality: :auto, fetch_format: :auto,
              class: "photo-grid-image", loading: "lazy",
              alt: "Photo #{index + 1} from #{photo.category}",
              draggable: false, oncontextmenu: "return false;", onselectstart: "return false;",
              ondragstart: "return false;" %>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="photos-empty">
      <i class="fas fa-camera photos-empty-icon" aria-hidden="true"></i>
      <% if @selected_category.present? %>
        <h2 class="photos-empty-title">No photos in <%= @selected_category.titleize %> yet</h2>
        <p class="photos-empty-text">Nothing here for this category at the moment.</p>
        <%= link_to "View all photos", photos_path, class: "btn btn-primary" %>
      <% else %>
        <h2 class="photos-empty-title">No photos yet</h2>
        <p class="photos-empty-text">Photos will appear here once they're uploaded.</p>
        <%= link_to "Browse projects", projects_path, class: "btn btn-outline-primary" %>
      <% end %>
    </div>
  <% end %>
</div>

<%= render "photos/photo_modal" if roll.any? %>
