<!-- Desktop Carousel: Always show 3 photos -->
<div class="desktop-carousel-container d-none d-md-block position-relative">
  <div id="featuredPhotosCarousel" class="featured-photos-desktop">
    <div class="photo-track" style="transform: translateX(0%);">
      <% if photos.size >= 3 %>
        <!-- Show all photos plus duplicates for seamless looping -->
        <% (photos.to_a * 2).each_with_index do |photo, index| %>
          <div class="photo-slide" data-slide="<%= index %>">
            <article class="carousel-card h-100 featured-photo-card" itemscope itemtype="https://schema.org/Photograph">
              <% if photo.image.attached? %>
                <%= link_to photo_path(photo),
                    data: {
                      bs_toggle: "modal",
                      bs_target: "#photoModal",
                      photo_id: photo.id,
                      photo_url: cl_image_path(photo.image.key, width: 1200, height: 800, crop: :fit, quality: :auto, fetch_format: :auto),
                      category: photo.category
                    } do %>
                  <%= cl_image_tag photo.image.key,
                      width: 400, height: 300, crop: :fill, quality: :auto, fetch_format: :auto,
                      class: "card-img-top featured-photo-image",
                      alt: "Featured photo from #{photo.category}",
                      itemprop: "image" %>
                <% end %>
              <% end %>
              <div class="card-body d-flex flex-column">
                <footer class="mt-auto text-center">
                  <%= link_to photos_path(category: photo.category),
                      class: "btn btn-outline-primary btn-sm" do %>
                    <i class="fas fa-camera me-1"></i>
                    <%= photo.category %>
                  <% end %>
                </footer>
              </div>
            </article>
          </div>
        <% end %>
      <% else %>
        <!-- If less than 3 photos, just show them regularly -->
        <% photos.each_with_index do |photo, index| %>
          <div class="photo-slide" data-slide="<%= index %>">
            <article class="carousel-card h-100 featured-photo-card" itemscope itemtype="https://schema.org/Photograph">
              <% if photo.image.attached? %>
                <%= link_to photo_path(photo),
                    data: {
                      bs_toggle: "modal",
                      bs_target: "#photoModal",
                      photo_id: photo.id,
                      photo_url: cl_image_path(photo.image.key, width: 1200, height: 800, crop: :fit, quality: :auto, fetch_format: :auto),
                      category: photo.category
                    } do %>
                  <%= cl_image_tag photo.image.key,
                      width: 400, height: 300, crop: :fill, quality: :auto, fetch_format: :auto,
                      class: "card-img-top featured-photo-image",
                      alt: "Featured photo from #{photo.category}",
                      itemprop: "image" %>
                <% end %>
              <% end %>
              <div class="card-body d-flex flex-column">
                <footer class="mt-auto text-center">
                  <%= link_to photos_path(category: photo.category),
                      class: "btn btn-outline-primary btn-sm" do %>
                    <i class="fas fa-camera me-1"></i>
                    <%= photo.category %>
                  <% end %>
                </footer>
              </div>
            </article>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>

  <!-- Arrow Controls -->
  <% if photos.size > 1 %>
    <button class="carousel-arrow carousel-arrow-prev" id="prevArrow">
      <i class="fas fa-chevron-left"></i>
    </button>
    <button class="carousel-arrow carousel-arrow-next" id="nextArrow">
      <i class="fas fa-chevron-right"></i>
    </button>
  <% end %>
</div>

<!-- Mobile Carousel: 1 photo at a time, swipeable -->
<div id="featuredPhotosMobile" class="carousel slide d-md-none" data-bs-ride="false" data-bs-interval="false">
  <div class="carousel-inner">
    <% mobile_photos = photos.to_a.shuffle %>
    <% mobile_photos.each_with_index do |photo, index| %>
      <div class="carousel-item <%= 'active' if index == 0 %>">
        <div class="row justify-content-center">
          <div class="col-10" itemscope itemtype="https://schema.org/Photograph">
            <article class="carousel-card h-100 featured-photo-card">
              <% if photo.image.attached? %>
                <%= link_to photo_path(photo),
                    data: {
                      bs_toggle: "modal",
                      bs_target: "#photoModal",
                      photo_id: photo.id,
                      photo_url: cl_image_path(photo.image.key, width: 1200, height: 800, crop: :fit, quality: :auto, fetch_format: :auto),
                      category: photo.category
                    } do %>
                  <%= cl_image_tag photo.image.key,
                      width: 400, height: 300, crop: :fill, quality: :auto, fetch_format: :auto,
                      class: "card-img-top featured-photo-image",
                      alt: "Featured photo from #{photo.category}",
                      itemprop: "image" %>
                <% end %>
              <% end %>
              <div class="card-body d-flex flex-column">
                <footer class="mt-auto text-center">
                  <%= link_to photos_path(category: photo.category),
                      class: "btn btn-outline-primary btn-sm" do %>
                    <i class="fas fa-camera me-1"></i>
                    <%= photo.category %>
                  <% end %>
                </footer>
              </div>
            </article>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Swipe hint for mobile (no dots) -->
  <% if mobile_photos.size > 1 %>
    <div class="text-center mt-3 d-md-none">
      <small class="text-muted">
        <i class="fas fa-hand-pointer me-1"></i>
        Swipe left or right to see more
      </small>
    </div>
  <% end %>
</div>

<!-- Photo Modal - Full Screen -->
<div class="modal fade" id="photoModal" tabindex="-1" aria-labelledby="photoModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-fullscreen">
    <div class="modal-content bg-black">
      <button type="button" class="photo-modal-close position-absolute top-0 end-0 m-3" data-bs-dismiss="modal" aria-label="Close">
        <i class="fas fa-times"></i>
      </button>
      <div class="modal-body d-flex align-items-center justify-content-center p-0">
        <img id="modalPhotoImage" src="" alt="" class="img-fluid" style="max-height: 100vh; max-width: 100vw; object-fit: contain;">
      </div>
    </div>
  </div>
</div>

<script>
(function() {
  'use strict';

  let desktopCarousel = null;
  let mobileCarousel = null;

  function initCarousel() {
    // Desktop carousel logic
    const track = document.querySelector('.photo-track');
    const nextBtn = document.getElementById('nextArrow');
    const prevBtn = document.getElementById('prevArrow');
    
    if (track && nextBtn && prevBtn) {
      const slides = document.querySelectorAll('.desktop-carousel-container .photo-slide');
      const totalSlides = slides.length;
      const originalCount = Math.floor(totalSlides / 2) || totalSlides;
      let currentIndex = 0;

      function updateCarousel(instant = false) {
        const translateX = -(currentIndex * 33.333);
        
        if (instant) {
          track.style.transition = 'none';
        } else {
          track.style.transition = 'transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94)';
        }
        
        track.style.transform = `translateX(${translateX}%)`;
        
        if (instant) {
          // Force reflow
          track.offsetHeight;
        }
      }

      function nextSlide() {
        currentIndex++;
        updateCarousel();
        
        if (currentIndex >= originalCount && totalSlides > originalCount) {
          setTimeout(() => {
            currentIndex = 0;
            updateCarousel(true);
          }, 400);
        }
      }

      function prevSlide() {
        if (currentIndex <= 0 && totalSlides > originalCount) {
          currentIndex = originalCount;
          updateCarousel(true);
          setTimeout(() => {
            currentIndex = originalCount - 1;
            updateCarousel();
          }, 50);
        } else {
          currentIndex = Math.max(0, currentIndex - 1);
          updateCarousel();
        }
      }

      // Remove old listeners
      nextBtn.replaceWith(nextBtn.cloneNode(true));
      prevBtn.replaceWith(prevBtn.cloneNode(true));
      
      // Re-get references and add new listeners
      const newNextBtn = document.getElementById('nextArrow');
      const newPrevBtn = document.getElementById('prevArrow');
      
      newNextBtn.addEventListener('click', (e) => {
        e.preventDefault();
        nextSlide();
      });

      newPrevBtn.addEventListener('click', (e) => {
        e.preventDefault();
        prevSlide();
      });

      desktopCarousel = { nextSlide, prevSlide, updateCarousel };
    }

    // Mobile carousel initialization
    const mobileEl = document.getElementById('featuredPhotosMobile');
    if (mobileEl && typeof bootstrap !== 'undefined') {
      // Dispose existing carousel if any
      const existingCarousel = bootstrap.Carousel.getInstance(mobileEl);
      if (existingCarousel) {
        existingCarousel.dispose();
      }

      mobileCarousel = new bootstrap.Carousel(mobileEl, {
        interval: false,
        touch: true,
        wrap: true
      });
    }

    // Photo modal
    const modal = document.getElementById('photoModal');
    const modalImg = document.getElementById('modalPhotoImage');
    if (modal && modalImg) {
      modal.addEventListener('show.bs.modal', function(e) {
        const trigger = e.relatedTarget;
        if (trigger) {
          const url = trigger.dataset.photoUrl;
          const category = trigger.dataset.category;
          if (url) {
            modalImg.src = url;
            modalImg.alt = `Featured photo from ${category}`;
          }
        }
      });
    }
  }

  // Clean initialization
  function initialize() {
    if (typeof bootstrap === 'undefined') {
      setTimeout(initialize, 50);
      return;
    }
    initCarousel();
  }

  // Initialize on DOM ready and Turbo navigation
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initialize);
  } else {
    initialize();
  }
  
  document.addEventListener('turbo:load', initialize);
})();
</script>