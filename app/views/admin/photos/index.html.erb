<% if notice %>
  <div class="alert alert-success alert-dismissible fade show" role="alert">
    <%= notice %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
<% end %>
<% if alert %>
  <div class="alert alert-warning alert-dismissible fade show" role="alert">
    <%= alert %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
<% end %>
<div class="d-flex justify-content-between align-items-center mb-4">
  <h1>Photos Admin</h1>
  <div>
    <%= link_to "Bulk Upload", bulk_upload_admin_photos_path, class: "btn btn-success me-2" %>
    <%= link_to "New Photo", new_admin_photo_path, class: "btn btn-primary" %>
  </div>
</div>
<% if @photos.any? %>
  <div class="mb-3">
    <strong>Total Photos:</strong> <%= @photos.count %>
    <strong>Categories:</strong> <%= Photo.categories.count %>
  </div>
  <% @photos.group_by(&:category).each do |category, photos| %>
    <div class="card mb-4">
      <div class="card-header d-flex justify-content-between align-items-center">
        <h4 class="mb-0">
          <%= category %>
          <span class="badge bg-secondary"><%= photos.count %> photos</span>
          <% locations = photos.map(&:location).compact.uniq.reject(&:blank?) %>
          <% if locations.any? %>
            <small class="text-muted ms-2">
              <i class="fas fa-map-marker-alt"></i> <%= locations.join(', ') %>
            </small>
          <% end %>
        </h4>
        <div>
          <%= link_to "Add More", bulk_upload_admin_photos_path(category: category), class: "btn btn-sm btn-outline-primary me-2" %>
          <button type="button" class="btn btn-sm btn-outline-secondary me-2" data-bs-toggle="modal" data-bs-target="#renameModal<%= Digest::MD5.hexdigest(category)[0..7] %>">
            Rename Category
          </button>
          <%= link_to "Delete Category",
              destroy_category_admin_photos_path(category_name: CGI.escape(category)),
              data: {
                turbo_method: :delete,
                turbo_confirm: "Are you sure you want to delete all #{photos.count} photos in '#{h category}'? This cannot be undone."
              },
              class: "btn btn-sm btn-outline-danger" %>
        </div>
      </div>
      <div class="card-body">
        <div class="row">
          <% photos.each do |photo| %>
            <div class="col-md-3 col-sm-6 mb-3">
              <div class="card <%= 'border-warning' if photo.featured? %>">
                <% if photo.featured? %>
                  <div class="position-absolute top-0 start-0 m-2">
                    <span class="badge bg-warning text-dark">Featured</span>
                  </div>
                <% end %>
                <% if photo.image.attached? %>
                  <%= cl_image_tag photo.image.key,
                      width: 300, height: 200, crop: :fill,
                      class: "card-img-top",
                      style: "height: 200px; object-fit: cover;" %>
                <% end %>
                <div class="card-body p-2">
                  <div class="d-grid gap-1">
                    <div class="btn-group" role="group">
                      <%= link_to "View", admin_photo_path(photo), class: "btn btn-outline-primary btn-sm" %>
                      <%= link_to "Edit", edit_admin_photo_path(photo), class: "btn btn-outline-secondary btn-sm" %>
                      <%= link_to "Delete", admin_photo_path(photo),
                          data: {
                            turbo_method: :delete,
                            turbo_confirm: "Are you sure?"
                          },
                          class: "btn btn-outline-danger btn-sm" %>
                    </div>
                    <% if photo.featured? %>
                      <%= link_to "Unfeature", unfeature_admin_photo_path(photo),
                          data: { turbo_method: :patch },
                          class: "btn btn-warning btn-sm" %>
                    <% else %>
                      <%= link_to "Feature", feature_admin_photo_path(photo),
                          data: { turbo_method: :patch },
                          class: "btn btn-success btn-sm" %>
                    <% end %>
                  </div>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
    
    <!-- Rename Category Modal for <%= h category %> -->
    <% modal_id = Digest::MD5.hexdigest(category)[0..7] %>
    <div class="modal fade" id="renameModal<%= modal_id %>" tabindex="-1" aria-labelledby="renameModalLabel<%= modal_id %>" aria-hidden="true">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="renameModalLabel<%= modal_id %>">Rename Category</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <%= form_with url: rename_category_admin_photos_path(category_name: CGI.escape(category)), method: :patch, local: true do |form| %>
            <div class="modal-body">
              <p>Current category name: <strong><%= h category %></strong></p>
              <p class="text-muted">This will rename all <%= photos.count %> photos in this category.</p>
              <div class="mb-3">
                <%= form.label :new_category_name, "New Category Name", class: "form-label" %>
                <%= form.text_field :new_category_name, value: h(category), class: "form-control", required: true, maxlength: 100 %>
                <div class="form-text">Maximum 100 characters. Must be unique (case-insensitive).</div>
              </div>
            </div>
            <div class="modal-footer">
              <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
              <%= form.submit "Rename Category", class: "btn btn-primary" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
<% else %>
  <div class="text-center py-5">
    <i class="fas fa-camera fa-3x text-muted mb-3"></i>
    <h3>No Photos Yet</h3>
    <p class="text-muted">Start building your photo portfolio by uploading some images.</p>
    <div class="mt-3">
      <%= link_to "Upload Multiple Photos", bulk_upload_admin_photos_path, class: "btn btn-success btn-lg me-2" %>
      <%= link_to "Upload Single Photo", new_admin_photo_path, class: "btn btn-primary btn-lg" %>
    </div>
  </div>
<% end %>
