<%= simple_form_for(@event, url: @event.persisted? ? admin_event_path(@event) : admin_events_path) do |f| %>
  <%= f.error_notification %>
  <%= f.error_notification message: f.object.errors[:base].to_sentence if f.object.errors[:base].present? %>
  <div class="form-inputs">
    <%= f.input :title, hint: "The name of your event (e.g., 'Photography Workshop')" %>
    <%= f.input :description, as: :text, input_html: { rows: 5 }, hint: "Describe what this event is about, when it's happening, etc." %>

    <!-- Hidden field to preserve event type -->
    <%= f.input :event_type, as: :hidden %>

    <div class="alert alert-info">
      <strong>Event Type:</strong>
      <%= @event.event_type == 'bbq' ? 'BBQ Event (Table-based seating)' : 'Normal Event (Simple capacity)' %>
    </div>

    <%= f.input :active, hint: "Only active events will be visible to users for signup" %>

    <!-- Show BBQ-specific fields -->
    <% if @event.bbq_event? %>
      <div class="capacity-section mt-4">
        <h6>BBQ Table Management (Optional)</h6>
        <p class="text-muted small">
          <strong>How it works:</strong> Tables seat 10 people each ($200/table).<br>
          If you set a target, people signing up OVER table limits (11+, 21+, etc.) will get pending warnings until you reach the next table.
        </p>
        <%= f.input :target_capacity,
            label: "Target Attendees",
            hint: "How many people do you want? (10, 20, 30, etc.) Leave blank to disable pending warnings." %>
      </div>
    <% end %>

    <!-- Show Normal event-specific fields -->
    <% if @event.normal_event? %>
      <div class="capacity-section mt-4">
        <h6>Event Capacity (Optional)</h6>
        <p class="text-muted small">
          <strong>How it works:</strong> Simple capacity limit.<br>
          When this number is reached, the event will show as full with contact information.
        </p>
        <%= f.input :target_capacity,
            label: "Maximum Attendees",
            hint: "How many people maximum? Leave blank for unlimited." %>
      </div>

      <div class="mt-4">
        <%= f.input :enable_bringing_categories,
            as: :boolean,
            label: "Enable 'What are you bringing?' categories",
            hint: "Check this to add dropdown for attendees to select what they're bringing (food categories for potlucks, etc.)" %>
      </div>
    <% end %>

  </div>
  <div class="form-actions">
    <%= f.button :submit %>
  </div>
<% end %>
