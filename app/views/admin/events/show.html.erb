<div class="row">
  <div class="col-md-8">
    <div class="card">
      <div class="card-body">
        <h1 class="card-title">
          <%= @event.title %>
          <% if @event.active? %>
            <span class="badge bg-success">Active</span>
          <% else %>
            <span class="badge bg-secondary">Inactive</span>
          <% end %>
        </h1>
        <p class="card-text"><%= simple_format(@event.description) %></p>
        <p class="text-muted">
          <strong>Created:</strong> <%= @event.created_at.strftime("%B %d, %Y at %I:%M %p") %><br>
          <strong>Total Attendees:</strong> <%= @event.attendee_count %>
          <% if @event.target_capacity.present? %>
            / <%= @event.target_capacity %> target
          <% end %>
        </p>
        <% if @event.target_capacity.present? %>
          <div class="capacity-info mt-3">
            <h6>BBQ Table Capacity</h6>
            <% if @event.in_pending_zone? %>
              <div class="alert alert-warning">
                <strong>⚠️ Pending Zone Active</strong><br>
                <%= @event.capacity_warning_message %>
              </div>
            <% else %>
              <div class="alert alert-success">
                <strong>✅ Table Status Good</strong><br>
                Current count (<%= @event.attendee_count %>) is at a good table boundary.
              </div>
            <% end %>
            <small class="text-muted">
              Next table threshold: <%= @event.next_table_threshold %> people<br>
              Target capacity: <%= @event.target_capacity || "Not set" %>
            </small>
          </div>
        <% end %>
      </div>
    </div>
    <% if @event.requires_bringing_field? && @attendees.any? %>
      <div class="card mt-4">
        <div class="card-header">
          <h3>Bringing Summary</h3>
        </div>
        <div class="card-body">
          <% breakdown = @event.bringing_breakdown %>
          <% categories_with_people = breakdown.select { |category, count| count > 0 } %>
          <% if categories_with_people.any? %>
            <p>
              <%= categories_with_people.map { |category, count|
                "#{category}: #{count} #{count == 1 ? 'person' : 'people'}"
              }.join(' • ') %>
            </p>
          <% else %>
            <p class="text-muted">No one has specified what they're bringing yet.</p>
          <% end %>
        </div>
      </div>
    <% end %>

    <%= render "admin/events/attendee_list", event: @event, attendees: @attendees %>
  </div>
  <div class="col-md-4">
    <div class="card">
      <div class="card-header">
        <h5>Actions</h5>
      </div>
      <div class="card-body">
        <%= link_to "Edit Event", edit_admin_event_path(@event), class: "btn btn-primary w-100 mb-2" %>
        <%= link_to "View Public Page", event_path(@event), class: "btn btn-outline-secondary w-100 mb-2", target: "_blank" %>
        <% if @attendees.any? %>
          <% everyone = whole_guest_list(@attendees.size) %>
          <%= button_to "Remove #{everyone}", remove_all_admin_event_attendees_path(@event),
              method: :delete,
              form: { data: { turbo_confirm: "Remove #{everyone} from #{@event.title}? " \
                                             "The event stays, ready to reuse. This can't be undone." } },
              class: "btn btn-outline-danger w-100 mb-2" %>
        <% end %>
        <hr>
        <%= link_to "Back to Events", admin_events_path, class: "btn btn-secondary w-100 mb-2" %>
        <% going_too = " and #{whole_guest_list(@attendees.size)}" if @attendees.any? %>
        <%= button_to "Delete Event", admin_event_path(@event), method: :delete,
            form: { data: { turbo_confirm: "Delete #{@event.title}#{going_too}? This can't be undone." } },
            class: "btn btn-danger w-100" %>
      </div>
    </div>
  </div>
</div>
