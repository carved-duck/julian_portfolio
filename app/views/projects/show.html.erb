<% content_for :structured_data do %>
  <script type="application/ld+json">
    <%= structured_data_for_project(@project) %>
  </script>
<% end %>
<% content_for :page_title, page_title_for_project(@project) %>
<script>
  // Track project view in Google Analytics. Turbo does not fire DOMContentLoaded on
  // navigations, so bind turbo:load too (see app/javascript/application.js).
  function trackProjectViewOnLoad() {
    if (typeof window.trackProjectView === 'function') {
      window.trackProjectView('<%= escape_javascript(@project.title) %>');
    }
  }
  document.addEventListener('DOMContentLoaded', trackProjectViewOnLoad);
  document.addEventListener('turbo:load', trackProjectViewOnLoad);
</script>
<article class="container mt-4" itemscope itemtype="https://schema.org/CreativeWork">
  <nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><%= link_to "Home", root_path, class: "text-decoration-none" %></li>
      <li class="breadcrumb-item"><%= link_to "Projects", projects_path, class: "text-decoration-none" %></li>
      <li class="breadcrumb-item active" aria-current="page"><%= @project.title.strip %></li>
    </ol>
  </nav>

  <%# Same shape as the Projects page's hero: the device beside the title, intro, stack and links. %>
  <header class="project-featured">
    <div class="project-featured-media slide-card-media slide-card-media--device slide-card-media--<%= @project.frame %>"
         style="--accent: <%= project_accent(@project) %>">
      <%= render "projects/device", project: @project %>
    </div>
    <div class="project-featured-body">
      <h1 class="project-featured-title page-title" itemprop="name"><%= @project.title.strip %></h1>
      <p class="project-featured-desc" itemprop="description"><%= @project.description.to_s.squish %></p>
      <% if @project.tag_list.any? %>
        <ul class="project-tags list-unstyled" aria-label="Stack">
          <% @project.tag_list.each do |tag| %>
            <li class="tag-pill" itemprop="keywords"><%= tag %></li>
          <% end %>
        </ul>
      <% end %>
      <div class="project-featured-actions d-flex flex-wrap gap-2">
        <%= render "projects/links", project: @project %>
      </div>
    </div>
  </header>

  <% if @project.highlight_list.any? %>
    <section class="project-built" aria-labelledby="what-i-built">
      <h2 id="what-i-built">What I built</h2>
      <ul>
        <% @project.highlight_list.each do |line| %>
          <li><%= line %></li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <footer class="project-page-footer">
    <%= link_to projects_path, class: "btn btn-outline-primary" do %>
      <i class="fas fa-arrow-left me-1" aria-hidden="true"></i> All projects
    <% end %>
  </footer>
</article>

<% if @more_projects.any? %>
  <section class="container project-more" aria-labelledby="more-projects">
    <h2 class="projects-grid-heading" id="more-projects">More projects</h2>
    <div class="project-era-grid">
      <%= render partial: "pages/project_slide", collection: @more_projects, as: :project %>
    </div>
  </section>
<% end %>
